#!/bin/bash
# Pred commitom prejde všetky súbory repa na mená a adresy (lib/public_check.mjs)
# a na odkazy na cesty, ktoré v repe nie sú (lib/path_check.mjs).
# Zapnutie: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node lib/public_check.mjs || exit 1
node lib/path_check.mjs || exit 1
