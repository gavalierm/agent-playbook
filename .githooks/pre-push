#!/bin/bash
# Pred pushom spustí kontroly pre-commit a skontroluje meno autora a správy
# commitov, ktoré idú von (lib/public_check.mjs z klonu agent-runtime).
# Zapnutie: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
"$PWD/.githooks/pre-commit" || exit 1
root="$PWD"
runtime="${AGENT_RUNTIME:-$root/../agent-runtime}"
export PUBLIC_CHECK_ROOT="$root" PUBLIC_CHECK_LIST="$root/lib/public_check.txt"
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
    node "$runtime/lib/public_check.mjs" --commits "$range" || exit 1
done
